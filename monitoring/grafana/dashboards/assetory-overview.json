{
  "uid": "assetory-overview",
  "title": "Assetory Overview",
  "tags": [
    "assetory"
  ],
  "timezone": "Asia/Seoul",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "description": "애플리케이션 상태 · HTTP · DB · 커넥션 풀 · JVM (FR-OP-01). 배치 · 외부 API · LLM · 분석 품질 · 알림 패널(FR-OP-07)은 해당 기능 구현 후 추가",
  "panels": [
    {
      "id": 1,
      "title": "애플리케이션 상태",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "assetory-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "expr": "up{job=\"assetory\"}",
          "legendFormat": "{{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "assetory-prometheus"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value"
      },
      "description": "Prometheus가 관리 포트(/actuator/prometheus)를 수집할 수 있으면 UP"
    },
    {
      "id": 2,
      "title": "HTTP 요청 수 · 5xx 비율",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "assetory-prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 18,
        "h": 5
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"assetory\", uri!~\"/actuator.*\"}[$__rate_interval]))",
          "legendFormat": "요청/s",
          "datasource": {
            "type": "prometheus",
            "uid": "assetory-prometheus"
          },
          "refId": "A"
        },
        {
          "expr": "(sum(rate(http_server_requests_seconds_count{application=\"assetory\", uri!~\"/actuator.*\", status=~\"5..\"}[$__rate_interval])) or vector(0)) / sum(rate(http_server_requests_seconds_count{application=\"assetory\", uri!~\"/actuator.*\"}[$__rate_interval]))",
          "legendFormat": "5xx 비율",
          "datasource": {
            "type": "prometheus",
            "uid": "assetory-prometheus"
          },
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "5xx 비율"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              },
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "max",
                "value": 1
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "title": "HTTP 응답시간 p95 (uri별)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "assetory-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, method, uri) (rate(http_server_requests_seconds_bucket{application=\"assetory\", uri!~\"/actuator.*\"}[$__rate_interval])))",
          "legendFormat": "{{method}} {{uri}}",
          "datasource": {
            "type": "prometheus",
            "uid": "assetory-prometheus"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "thresholdsStyle": {
              "mode": "line+area"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "red",
                "value": 0.5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "NFR-PF-01 주요 조회 API p95 500ms 이내 — 빨간 영역이 500ms 초과"
    },
    {
      "id": 4,
      "title": "HTTP 응답시간 p99 (uri별)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "assetory-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le, method, uri) (rate(http_server_requests_seconds_bucket{application=\"assetory\", uri!~\"/actuator.*\"}[$__rate_interval])))",
          "legendFormat": "{{method}} {{uri}}",
          "datasource": {
            "type": "prometheus",
            "uid": "assetory-prometheus"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "thresholdsStyle": {
              "mode": "line+area"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "red",
                "value": 0.5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 5,
      "title": "Repository 메서드 p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "assetory-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, repository, method) (rate(spring_data_repository_invocations_seconds_bucket{application=\"assetory\"}[$__rate_interval])))",
          "legendFormat": "{{repository}}.{{method}}",
          "datasource": {
            "type": "prometheus",
            "uid": "assetory-prometheus"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "DB 접근 시간 개선 전후 비교용 (spring.data.repository.invocations)"
    },
    {
      "id": 6,
      "title": "HikariCP 커넥션",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "assetory-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (pool) (hikaricp_connections_active{application=\"assetory\"})",
          "legendFormat": "활성 {{pool}}",
          "datasource": {
            "type": "prometheus",
            "uid": "assetory-prometheus"
          },
          "refId": "A"
        },
        {
          "expr": "sum by (pool) (hikaricp_connections_pending{application=\"assetory\"})",
          "legendFormat": "대기 {{pool}}",
          "datasource": {
            "type": "prometheus",
            "uid": "assetory-prometheus"
          },
          "refId": "B"
        },
        {
          "expr": "sum by (pool) (hikaricp_connections_max{application=\"assetory\"})",
          "legendFormat": "최대 {{pool}}",
          "datasource": {
            "type": "prometheus",
            "uid": "assetory-prometheus"
          },
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "title": "JVM 힙 사용량",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "assetory-prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 21,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(jvm_memory_used_bytes{application=\"assetory\", area=\"heap\"})",
          "legendFormat": "사용",
          "datasource": {
            "type": "prometheus",
            "uid": "assetory-prometheus"
          },
          "refId": "A"
        },
        {
          "expr": "sum(jvm_memory_max_bytes{application=\"assetory\", area=\"heap\"})",
          "legendFormat": "최대",
          "datasource": {
            "type": "prometheus",
            "uid": "assetory-prometheus"
          },
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "title": "GC 일시정지",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "assetory-prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 21,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (action, cause) (rate(jvm_gc_pause_seconds_sum{application=\"assetory\"}[$__rate_interval])) / sum by (action, cause) (rate(jvm_gc_pause_seconds_count{application=\"assetory\"}[$__rate_interval]))",
          "legendFormat": "평균 {{action}} ({{cause}})",
          "datasource": {
            "type": "prometheus",
            "uid": "assetory-prometheus"
          },
          "refId": "A"
        },
        {
          "expr": "max by (action) (jvm_gc_pause_seconds_max{application=\"assetory\"})",
          "legendFormat": "최대 {{action}}",
          "datasource": {
            "type": "prometheus",
            "uid": "assetory-prometheus"
          },
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
  ]
}