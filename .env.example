# Database (docker-compose MySQL — 로컬에 이미 3306을 쓰는 MySQL이 있으면 3307 사용)
DB_NAME=
DB_PORT=
DB_ROOT_PASSWORD=
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# Redis
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=

# AES-256 키 (Base64 인코딩된 32바이트)
ASSETORY_AES_KEY=

# JWT 서명 키 (32바이트 이상)
JWT_SECRET=
# 만료(ms) — 기본값 AT 30분 / RT 14일. 바꿀 때만 주석 해제
# JWT_EXPIRATION_MS=
# JWT_REFRESH_EXPIRATION_MS=

# 메일 (SMTP) — 인증코드 발송용
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=

# CORS 허용 origin (쉼표 구분)
CORS_ALLOWED_ORIGINS=
