# Database (docker-compose MySQL — 로컬에 이미 3306을 쓰는 MySQL이 있으면 3307 사용)
DB_NAME=
DB_PORT=
DB_ROOT_PASSWORD=
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# Redis
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=

# AES-256 키 (Base64 인코딩된 32바이트)
ASSETORY_AES_KEY=

# JWT 서명 키 (32바이트 이상)
JWT_SECRET=
# 만료(ms) — 기본값 AT 30분 / RT 14일. 바꿀 때만 주석 해제
# JWT_EXPIRATION_MS=
# JWT_REFRESH_EXPIRATION_MS=

# 메일 (SMTP) — 인증코드 발송용
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
# 발신 주소 (비우면 MAIL_USERNAME)
MAIL_FROM=

# CODEF (client id/secret, RSA 공개키) — 서비스 타입 0: 정식, 1: 데모(기본)
CODEF_CLIENT_ID=
CODEF_CLIENT_SECRET=
CODEF_PUBLIC_KEY=
# CODEF_SERVICE_TYPE=1
# 일일 자산 기록 배치(CODEF · 시세 · 스냅샷) — 기본 비활성, 기본 cron 영업일 16:00. 켤 때만 주석 해제
# ASSETORY_SYNC_BATCH_ENABLED=true
# ASSETORY_SYNC_BATCH_CRON=0 0 16 * * MON-FRI
# ASSETORY_SYNC_BATCH_LOCK_RETRY_WAIT_MS=10000
# 잠정 종가 보정(다음 거래일 아침에 직전 기록을 확정 종가로 다시 평가) — 일일 배치와 함께 켠다. 기본 cron 영업일 07:30
# ASSETORY_SYNC_CONFIRM_ENABLED=true
# ASSETORY_SYNC_CONFIRM_CRON=0 30 7 * * MON-FRI

# 한투(KIS) Open API — 시세 조회용 앱키 · 시크릿. 도메인 기본은 실전, 모의로 바꿀 때만 주석 해제
KIS_APP_KEY=
KIS_APP_SECRET=
# KIS_BASE_URL=https://openapivts.koreainvestment.com:29443
# KIS_CALL_INTERVAL_MS=500

# 근거 소스 — OpenDART 인증키 · 한국은행 ECOS 인증키 · NAVER API HUB(네이버 클라우드) Client ID / Client Secret
# 지금은 실호출 검증(evidenceLiveTest, docs/ops/evidence-source-verification.md)에서만 쓴다
DART_API_KEY=
ECOS_API_KEY=
NAVER_API_HUB_CLIENT_ID=
NAVER_API_HUB_CLIENT_SECRET=

# CORS 허용 origin (쉼표 구분)
CORS_ALLOWED_ORIGINS=

# Swagger UI — 기본 비활성. local에서 켤 때만 주석 해제 (prod는 설정 파일에서 강제 비활성)
# SWAGGER_ENABLED=true

# 운영 지표 — Actuator 관리 포트 (기본 8082, API 포트와 분리). 운영 보안그룹에서 열지 않는다
# MANAGEMENT_SERVER_PORT=8082

# 로컬 Prometheus · Grafana (`docker compose --profile monitoring up -d`일 때만 사용)
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=
# PROMETHEUS_PORT=9090
# GRAFANA_PORT=3000
